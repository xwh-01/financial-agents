APP_NAME=Market Impact Agent
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8001
ENVIRONMENT=development

LLM_BASE_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=1.0

NEWS_BASE_URL=
NEWS_API_KEY=

COMPANY_FEEDS_PATH=config/company_feeds.json
MARKET_FEEDS_PATH=config/market_feeds.json
ENABLE_COMPANY_RSS=true
ENABLE_MARKET_RSS=true
RSS_TIMEOUT_SECONDS=15
MIN_NEWS_COUNT=10

MARKET_BASE_URL=
MARKET_API_KEY=

JWT_SECRET=
TOKEN_EXPIRE_DAYS=7

ENABLE_REPORT_SCHEDULER=false
DAILY_REPORT_HOUR=8
DAILY_REPORT_MINUTE=0
REPORT_JOB_SCAN_SECONDS=60
REPORT_JOB_SCAN_INTERVAL_SECONDS=5
REPORT_JOB_STALE_SECONDS=1800
MARKET_PULSE_ANALYSIS_CONCURRENCY=3
MARKET_PULSE_ANALYSIS_TIMEOUT_SECONDS=90
