ENVIRONMENT=development

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

MARKETAUX_API_KEY=
NEWS_PAGE_SIZE=20
TRACE_DIR=traces

NEWS_API_KEY=your_marketaux_key
NEWS_BASE_URL=https://api.marketaux.com/v1/news/all

MARKET_BASE_URL=https://www.alphavantage.co/query
MARKET_API_KEY=your_alpha_vantage_key

JWT_SECRET=your_jwt_secret_here
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Runtime storage and worker settings.
REPORTS_DB_PATH=/data/reports.db
ENABLE_REPORT_SCHEDULER=false
DAILY_REPORT_HOUR=8
DAILY_REPORT_MINUTE=0
REPORT_JOB_SCAN_INTERVAL_SECONDS=5
